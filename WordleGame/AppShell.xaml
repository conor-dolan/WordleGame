<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:view="clr-namespace:WordleGame.View"
       x:Class="WordleGame.AppShell">

    <!-- Define the route for LoginPage -->
    <ShellContent Title="Login" ContentTemplate="{DataTemplate view:LoginPage}" Route="login"/>

    <!-- Define the route for MainPage -->
    <ShellContent Title="Main Menu" ContentTemplate="{DataTemplate view:MainPage}" Route="main" />

    <!-- Define the route for GamePage -->
    <ShellContent Title="Game" ContentTemplate="{DataTemplate view:GamePage}" Route="game" />

    <!-- Define the route for ScoreboardPage -->
    <ShellContent Title="Scoreboard" ContentTemplate="{DataTemplate view:ScoreboardPage}" Route="scoreboard"/>

    <!-- Define the route for SettingsPage -->
    <ShellContent Title="Settings" ContentTemplate="{DataTemplate view:SettingsPage}" Route="settings"/>

</Shell>